# Required for AI analysis + screenshot reading (rules work without it)
GROQ_API_KEY=your-groq-key-here
# Text model used for emails, SMS and pasted messages
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss reasoning effort: low (fast, default) | medium | high
GROQ_REASONING_EFFORT=low
# gpt-oss is text-only, so this separate vision model is used ONLY for uploaded screenshots in app.py
GROQ_VISION_MODEL=qwen/qwen3.6-27b
# Optional: Google Safe Browsing API key for live link reputation checks
GOOGLE_SAFE_BROWSING_KEY=

# ---- Gmail auto-scan ----
# 1 = read-only (no labels are added to your mailbox); 0 = add ScamGuard labels
SCAMGUARD_READONLY=0
SCAN_QUERY=in:inbox newer_than:7d
SCAN_INTERVAL_MIN=5
# Trusted sender domains to skip entirely, e.g. mycompany.com,hdfcbank.net
SCAN_ALLOWLIST=

# 1 = also add ScamGuard/Scam and ScamGuard/Suspicious labels in Gmail (default 0 = off;
# results are shown beside each email by the Chrome extension and in the dashboard instead)
SCAN_APPLY_LABELS=0
