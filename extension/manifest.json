{
  "manifest_version": 3,
  "name": "ScamGuard for Gmail",
  "version": "1.0.0",
  "description": "Automatically flags scam and phishing emails in Gmail and shows the scam type next to each one.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://mail.google.com/*", "http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://mail.google.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html", "default_title": "ScamGuard" }
}
